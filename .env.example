# API runtime configuration. Copy to .env for local development.
# API runtime configuration. Copy to .env for local development.
NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://DB_USER:DB_PASSWORD@DB_HOST:5432/DB_NAME
LIVE_SITE_URL=https://your-real-deployed-domain.com
QA_USER=qa-account-username
QA_PASS=qa-account-password


# Optional in development; required in production. Use a private, persistent absolute path outside the web root.
# STUDENT_DOCUMENT_STORAGE_DIR=/srv/hms/private/student-documents
# Required in production; absolute path to the ClamAV clamscan executable.
# STUDENT_DOCUMENT_SCANNER_PATH=/usr/bin/clamscan
