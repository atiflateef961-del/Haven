generator client {
  provider        = "prisma-client"
  output          = "../generated/prisma"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  INVITED
  SUSPENDED
}

enum StudentStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  GRADUATED
  PROBATION
  LEAVE_OF_ABSENCE
}

enum BookingStatus {
  REQUESTED
  APPROVED
  REJECTED
  CANCELLED
  FULFILLED
}

enum AllocationStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  VOID
  OVERDUE
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

enum PaymentMethod {
  CASH
  CARD
  BANK_TRANSFER
  ONLINE
  OTHER
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
  COMPLETED
}

enum ComplaintStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum MaintenanceStatus {
  OPEN
  ASSIGNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum MealType {
  BREAKFAST
  LUNCH
  DINNER
  SNACK
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

enum EmailDeliveryStatus {
  SENT
  FAILED
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

model Organization {
  id            String         @id @default(uuid()) @db.Uuid
  name          String         @db.VarChar(160)
  slug          String         @unique @db.VarChar(80)
  timezone      String         @default("UTC") @db.VarChar(64)
  currency      String         @default("USD") @db.Char(3)
  createdAt     DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime       @updatedAt @db.Timestamptz(6)
  archivedAt    DateTime?      @db.Timestamptz(6)
  memberships   Membership[]
  hostels       Hostel[]
  students      Student[]
  staff         Staff[]
  roles         Role[]
  announcements Announcement[]
  auditLogs     AuditLog[]
  notifications Notification[]
}

model User {
  id                  String               @id @default(uuid()) @db.Uuid
  email               String               @unique @db.VarChar(320)
  passwordHash        String?              @db.VarChar(255)
  firstName           String               @db.VarChar(100)
  lastName            String               @db.VarChar(100)
  phone               String?              @db.VarChar(32)
  status              UserStatus           @default(ACTIVE)
  createdAt           DateTime             @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime             @updatedAt @db.Timestamptz(6)
  memberships         Membership[]
  student             Student?
  staff               Staff?
  userRoles           UserRole[]
  notifications       Notification[]
  auditLogs           AuditLog[]
  sessions            Session[]
  passwordResetTokens PasswordResetToken[]
  createdPayments     Payment[]

  @@index([status, createdAt])
}

model Membership {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  userId         String       @db.Uuid
  joinedAt       DateTime     @default(now()) @db.Timestamptz(6)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user           User         @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([organizationId, userId])
  @@index([userId])
}

model Role {
  id              String           @id @default(uuid()) @db.Uuid
  organizationId  String?          @db.Uuid
  name            String           @db.VarChar(80)
  description     String?          @db.VarChar(255)
  organization    Organization?    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  userRoles       UserRole[]
  rolePermissions RolePermission[]

  @@unique([name], where: { organizationId: null })
  @@unique([organizationId, name], where: { organizationId: { not: null } })
  @@index([organizationId])
}

model Permission {
  id              String           @id @default(uuid()) @db.Uuid
  key             String           @unique @db.VarChar(120)
  description     String?          @db.VarChar(255)
  rolePermissions RolePermission[]
}

model UserRole {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @db.Uuid
  roleId         String   @db.Uuid
  organizationId String?  @db.Uuid
  hostelId       String?  @db.Uuid
  createdAt      DateTime @default(now()) @db.Timestamptz(6)
  user           User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  role           Role     @relation(fields: [roleId], references: [id], onDelete: Restrict)
  hostel         Hostel?  @relation(fields: [hostelId], references: [id], onDelete: Restrict)

  @@unique([userId, roleId], where: { organizationId: null, hostelId: null })
  @@unique([userId, roleId, organizationId], where: { organizationId: { not: null }, hostelId: null })
  @@unique([userId, roleId, hostelId], where: { organizationId: null, hostelId: { not: null } })
  @@unique([userId, roleId, organizationId, hostelId], where: { organizationId: { not: null }, hostelId: { not: null } })
  @@index([organizationId, userId])
}

model RolePermission {
  roleId       String     @db.Uuid
  permissionId String     @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Restrict)

  @@id([roleId, permissionId])
}

model Hostel {
  id               String         @id @default(uuid()) @db.Uuid
  organizationId   String         @db.Uuid
  name             String         @db.VarChar(160)
  code             String         @db.VarChar(40)
  address          String?        @db.VarChar(500)
  archivedAt       DateTime?      @db.Timestamptz(6)
  createdAt        DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime       @updatedAt @db.Timestamptz(6)
  organization     Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  buildings        Building[]
  messSchedules    MessSchedule[]
  userRoles        UserRole[]
  staffAssignments StaffHostel[]
  maintenanceRequests MaintenanceRequest[]

  @@unique([organizationId, code])
  @@index([organizationId, name])
  @@index([organizationId, archivedAt, name])
}

model Building {
  id       String  @id @default(uuid()) @db.Uuid
  hostelId String  @db.Uuid
  name     String  @db.VarChar(120)
  hostel   Hostel  @relation(fields: [hostelId], references: [id], onDelete: Restrict)
  floors   Floor[]

  @@unique([hostelId, name])
}

model Floor {
  id         String   @id @default(uuid()) @db.Uuid
  buildingId String   @db.Uuid
  number     Int
  building   Building @relation(fields: [buildingId], references: [id], onDelete: Restrict)
  rooms      Room[]

  @@unique([buildingId, number])
}

model Room {
  id          String    @id @default(uuid()) @db.Uuid
  floorId     String    @db.Uuid
  number      String    @db.VarChar(40)
  roomType    String?   @db.VarChar(60)
  description String?   @db.VarChar(500)
  archivedAt  DateTime? @db.Timestamptz(6)
  floor       Floor     @relation(fields: [floorId], references: [id], onDelete: Restrict)
  beds        Bed[]

  @@unique([floorId, number])
  @@index([floorId, archivedAt, number])
}

model Bed {
  id          String          @id @default(uuid()) @db.Uuid
  roomId      String          @db.Uuid
  label       String          @db.VarChar(40)
  isActive    Boolean         @default(true)
  room        Room            @relation(fields: [roomId], references: [id], onDelete: Restrict)
  allocations BedAllocation[]

  @@unique([roomId, label])
  @@index([roomId, isActive])
}

model Student {
  id                   String            @id @default(uuid()) @db.Uuid
  organizationId       String            @db.Uuid
  userId               String?           @unique @db.Uuid
  studentNumber        String            @db.VarChar(60)
  firstName            String            @db.VarChar(100)
  lastName             String            @db.VarChar(100)
  email                String?           @db.VarChar(320)
  phone                String?           @db.VarChar(32)
  dateOfBirth          DateTime?         @db.Date
  educationInstitution String?           @db.VarChar(180)
  educationProgram     String?           @db.VarChar(180)
  educationYear        String?           @db.VarChar(40)
  fatherName           String?           @db.VarChar(160)
  gender               String?           @db.VarChar(20)
  nationalId           String?           @db.VarChar(15)
  homeAddress          String?           @db.VarChar(500)
  profilePhotoUrl      String?           @db.VarChar(500)
  bio                  String?           @db.Text
  enrollmentDate       DateTime?         @db.Date
  sourceStatus         String?           @map("source_status") @db.Text
  status               StudentStatus     @default(ACTIVE)
  archivedAt           DateTime?         @db.Timestamptz(6)
  createdAt            DateTime          @default(now()) @db.Timestamptz(6)
  updatedAt            DateTime          @updatedAt @db.Timestamptz(6)
  organization         Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user                 User?             @relation(fields: [userId], references: [id], onDelete: Restrict)
  documents            StudentDocument[]
  guardians            Guardian[]
  bookings             Booking[]
  allocations          BedAllocation[]
  invoices             Invoice[]
  attendance           Attendance[]
  visitorRequests      VisitorRequest[]
  complaints           Complaint[]
  mealAttendances      MealAttendance[]
  leaveRequests        LeaveRequest[]

  @@unique([organizationId, studentNumber])
  @@unique([studentNumber, email, phone, nationalId], map: "Student_fixture_identity_key")
  @@index([organizationId, lastName, firstName])
}

model StudentDocument {
  id           String   @id @default(uuid()) @db.Uuid
  studentId    String   @db.Uuid
  documentType String   @db.VarChar(80)
  objectKey    String   @db.VarChar(500)
  contentType  String?  @db.VarChar(120)
  createdAt    DateTime @default(now()) @db.Timestamptz(6)
  student      Student  @relation(fields: [studentId], references: [id], onDelete: Restrict)

  @@index([studentId, createdAt])
}

model Guardian {
  id           String  @id @default(uuid()) @db.Uuid
  studentId    String  @db.Uuid
  name         String  @db.VarChar(160)
  relationship String? @db.VarChar(60)
  email        String? @db.VarChar(320)
  phone        String  @db.VarChar(32)
  student      Student @relation(fields: [studentId], references: [id], onDelete: Restrict)

  @@index([studentId])
}

model Staff {
  id                     String               @id @default(uuid()) @db.Uuid
  organizationId         String               @db.Uuid
  userId                 String               @unique @db.Uuid
  employeeNumber         String               @db.VarChar(60)
  jobTitle               String               @db.VarChar(120)
  archivedAt             DateTime?            @db.Timestamptz(6)
  createdAt              DateTime             @default(now()) @db.Timestamptz(6)
  organization           Organization         @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user                   User                 @relation(fields: [userId], references: [id], onDelete: Restrict)
  hostelAssignments      StaffHostel[]
  attendance             Attendance[]
  maintenanceAssignments MaintenanceRequest[]
  assignedComplaints    Complaint[]

  @@unique([organizationId, employeeNumber])
  @@index([organizationId])
  @@index([organizationId, archivedAt, employeeNumber])
}

model StaffHostel {
  staffId  String @db.Uuid
  hostelId String @db.Uuid
  staff    Staff  @relation(fields: [staffId], references: [id], onDelete: Restrict)
  hostel   Hostel @relation(fields: [hostelId], references: [id], onDelete: Restrict)

  @@id([staffId, hostelId])
}

model Booking {
  id             String          @id @default(uuid()) @db.Uuid
  studentId      String          @db.Uuid
  requestedFrom  DateTime        @db.Date
  requestedUntil DateTime?       @db.Date
  status         BookingStatus   @default(REQUESTED)
  notes          String?         @db.VarChar(1000)
  createdAt      DateTime        @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime        @updatedAt @db.Timestamptz(6)
  student        Student         @relation(fields: [studentId], references: [id], onDelete: Restrict)
  allocations    BedAllocation[]

  @@index([studentId, status, createdAt])
  @@index([status, requestedFrom])
}

model BedAllocation {
  id        String           @id @default(uuid()) @db.Uuid
  bookingId String?          @db.Uuid
  studentId String           @db.Uuid
  bedId     String           @db.Uuid
  status    AllocationStatus @default(ACTIVE)
  startsAt  DateTime         @db.Timestamptz(6)
  endsAt    DateTime?        @db.Timestamptz(6)
  endedAt   DateTime?        @db.Timestamptz(6)
  createdAt DateTime         @default(now()) @db.Timestamptz(6)
  booking   Booking?         @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  student   Student          @relation(fields: [studentId], references: [id], onDelete: Restrict)
  bed       Bed              @relation(fields: [bedId], references: [id], onDelete: Restrict)
  checkIn   CheckIn?
  checkOut  CheckOut?

  @@index([studentId, startsAt])
  @@index([bedId, startsAt])
}

model CheckIn {
  id           String        @id @default(uuid()) @db.Uuid
  allocationId String        @unique @db.Uuid
  checkedInAt  DateTime      @default(now()) @db.Timestamptz(6)
  notes        String?       @db.VarChar(1000)
  allocation   BedAllocation @relation(fields: [allocationId], references: [id], onDelete: Restrict)
}

model CheckOut {
  id           String        @id @default(uuid()) @db.Uuid
  allocationId String        @unique @db.Uuid
  checkedOutAt DateTime      @default(now()) @db.Timestamptz(6)
  notes        String?       @db.VarChar(1000)
  allocation   BedAllocation @relation(fields: [allocationId], references: [id], onDelete: Restrict)
}

model Invoice {
  id          String        @id @default(uuid()) @db.Uuid
  studentId   String        @db.Uuid
  number      String        @db.VarChar(60)
  status      InvoiceStatus @default(DRAFT)
  currency    String        @db.Char(3)
  issuedAt    DateTime?     @db.Timestamptz(6)
  dueAt       DateTime?     @db.Timestamptz(6)
  totalAmount Decimal       @default(0) @db.Decimal(12, 2)
  createdAt   DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime      @updatedAt @db.Timestamptz(6)
  student     Student       @relation(fields: [studentId], references: [id], onDelete: Restrict)
  items       InvoiceItem[]
  payments    Payment[]

  @@unique([studentId, number])
  @@index([studentId, status, dueAt])
}

model InvoiceItem {
  id          String  @id @default(uuid()) @db.Uuid
  invoiceId   String  @db.Uuid
  description String  @db.VarChar(255)
  quantity    Decimal @default(1) @db.Decimal(10, 2)
  unitAmount  Decimal @db.Decimal(12, 2)
  lineAmount  Decimal @db.Decimal(12, 2)
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict)

  @@index([invoiceId])
}

model Payment {
  id           String               @id @default(uuid()) @db.Uuid
  invoiceId    String               @db.Uuid
  actorId      String?              @db.Uuid
  amount       Decimal              @db.Decimal(12, 2)
  currency     String               @db.Char(3)
  method       PaymentMethod
  status       PaymentStatus        @default(PENDING)
  receivedAt   DateTime?            @db.Timestamptz(6)
  createdAt    DateTime             @default(now()) @db.Timestamptz(6)
  invoice      Invoice              @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  actor        User?                @relation(fields: [actorId], references: [id], onDelete: Restrict)
  transactions PaymentTransaction[]

  @@index([invoiceId, status, createdAt])
}

model PaymentTransaction {
  id             String   @id @default(uuid()) @db.Uuid
  paymentId      String   @db.Uuid
  provider       String   @db.VarChar(80)
  providerRef    String?  @db.VarChar(255)
  idempotencyKey String   @unique @db.VarChar(255)
  verified       Boolean  @default(false)
  result         Json?    @db.JsonB
  createdAt      DateTime @default(now()) @db.Timestamptz(6)
  payment        Payment  @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@index([provider, providerRef])
}

model Attendance {
  id             String           @id @default(uuid()) @db.Uuid
  studentId      String           @db.Uuid
  staffId        String?          @db.Uuid
  attendanceDate DateTime         @db.Date
  status         AttendanceStatus
  note           String?          @db.VarChar(500)
  student        Student          @relation(fields: [studentId], references: [id], onDelete: Restrict)
  staff          Staff?           @relation(fields: [staffId], references: [id], onDelete: Restrict)

  @@unique([studentId, attendanceDate])
  @@index([attendanceDate, status])
}

model Visitor {
  id       String           @id @default(uuid()) @db.Uuid
  name     String           @db.VarChar(160)
  phone    String?          @db.VarChar(32)
  requests VisitorRequest[]
}

model VisitorRequest {
  id        String        @id @default(uuid()) @db.Uuid
  studentId String        @db.Uuid
  visitorId String        @db.Uuid
  visitAt   DateTime      @db.Timestamptz(6)
  status    RequestStatus @default(PENDING)
  purpose   String?       @db.VarChar(500)
  createdAt DateTime      @default(now()) @db.Timestamptz(6)
  student   Student       @relation(fields: [studentId], references: [id], onDelete: Restrict)
  visitor   Visitor       @relation(fields: [visitorId], references: [id], onDelete: Restrict)

  @@index([studentId, status, visitAt])
}

model Complaint {
  id                  String               @id @default(uuid()) @db.Uuid
  studentId           String               @db.Uuid
  assignedStaffId     String?              @db.Uuid
  title               String               @db.VarChar(180)
  description         String               @db.VarChar(4000)
  status              ComplaintStatus      @default(OPEN)
  createdAt           DateTime             @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime             @updatedAt @db.Timestamptz(6)
  student             Student              @relation(fields: [studentId], references: [id], onDelete: Restrict)
  assignedStaff       Staff?               @relation(fields: [assignedStaffId], references: [id], onDelete: Restrict)
  maintenanceRequests MaintenanceRequest[]

  @@index([studentId, status, createdAt])
  @@index([assignedStaffId, status])
}

model MaintenanceRequest {
  id          String            @id @default(uuid()) @db.Uuid
  hostelId    String?           @db.Uuid
  complaintId String?           @db.Uuid
  assigneeId  String?           @db.Uuid
  title       String            @db.VarChar(180)
  description String            @db.VarChar(2000)
  status      MaintenanceStatus @default(OPEN)
  createdAt   DateTime          @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime          @updatedAt @db.Timestamptz(6)
  complaint   Complaint?        @relation(fields: [complaintId], references: [id], onDelete: Restrict)
  assignee    Staff?            @relation(fields: [assigneeId], references: [id], onDelete: Restrict)
  hostel      Hostel?           @relation(fields: [hostelId], references: [id], onDelete: Restrict)

  @@index([status, createdAt])
  @@index([assigneeId, status])
  @@index([hostelId, status, createdAt])
}

model MessSchedule {
  id         String           @id @default(uuid()) @db.Uuid
  hostelId   String           @db.Uuid
  mealType   MealType
  startsAt   DateTime         @db.Timestamptz(6)
  endsAt     DateTime         @db.Timestamptz(6)
  menu       String?          @db.VarChar(2000)
  hostel     Hostel           @relation(fields: [hostelId], references: [id], onDelete: Restrict)
  attendance MealAttendance[]

  @@index([hostelId, startsAt])
}

model MealAttendance {
  id             String       @id @default(uuid()) @db.Uuid
  studentId      String       @db.Uuid
  messScheduleId String       @db.Uuid
  attendedAt     DateTime     @default(now()) @db.Timestamptz(6)
  student        Student      @relation(fields: [studentId], references: [id], onDelete: Restrict)
  messSchedule   MessSchedule @relation(fields: [messScheduleId], references: [id], onDelete: Restrict)

  @@unique([studentId, messScheduleId])
  @@index([messScheduleId, attendedAt])
}

model Notification {
  id             String             @id @default(uuid()) @db.Uuid
  userId         String             @db.Uuid
  organizationId String?            @db.Uuid
  title          String             @db.VarChar(180)
  body           String             @db.VarChar(4000)
  status         NotificationStatus @default(PENDING)
  sentAt         DateTime?          @db.Timestamptz(6)
  readAt         DateTime?          @db.Timestamptz(6)
  emailStatus    EmailDeliveryStatus?
  emailSentAt    DateTime?          @db.Timestamptz(6)
  emailError     String?            @db.VarChar(500)
  createdAt      DateTime           @default(now()) @db.Timestamptz(6)
  user           User               @relation(fields: [userId], references: [id], onDelete: Restrict)
  organization   Organization?      @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([userId, status, createdAt])
  @@index([organizationId, userId, readAt, createdAt])
}

model Announcement {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  title          String       @db.VarChar(180)
  body           String       @db.VarChar(8000)
  publishedAt    DateTime?    @db.Timestamptz(6)
  expiresAt      DateTime?    @db.Timestamptz(6)
  createdAt      DateTime     @default(now()) @db.Timestamptz(6)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([organizationId, publishedAt])
}

model LeaveRequest {
  id        String      @id @default(uuid()) @db.Uuid
  studentId String      @db.Uuid
  startsAt  DateTime    @db.Timestamptz(6)
  endsAt    DateTime    @db.Timestamptz(6)
  reason    String      @db.VarChar(1000)
  status    LeaveStatus @default(PENDING)
  createdAt DateTime    @default(now()) @db.Timestamptz(6)
  updatedAt DateTime    @updatedAt @db.Timestamptz(6)
  student   Student     @relation(fields: [studentId], references: [id], onDelete: Restrict)

  @@index([studentId, status, startsAt])
}

model AuditLog {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String?       @db.Uuid
  actorId        String?       @db.Uuid
  action         String        @db.VarChar(120)
  resourceType   String        @db.VarChar(120)
  resourceId     String?       @db.VarChar(120)
  metadata       Json?         @db.JsonB
  createdAt      DateTime      @default(now()) @db.Timestamptz(6)
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  actor          User?         @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([organizationId, createdAt])
  @@index([actorId, createdAt])
  @@index([resourceType, resourceId])
}

model PasswordResetToken {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  tokenHash  String    @unique @db.VarChar(255)
  expiresAt  DateTime  @db.Timestamptz(6)
  consumedAt DateTime? @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @db.Timestamptz(6)
  user       User      @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, expiresAt])
}

model Session {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  tokenHash  String    @unique @db.VarChar(255)
  expiresAt  DateTime  @db.Timestamptz(6)
  revokedAt  DateTime? @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @db.Timestamptz(6)
  lastSeenAt DateTime  @default(now()) @db.Timestamptz(6)
  user       User      @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, expiresAt])
}
